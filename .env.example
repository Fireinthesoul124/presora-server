# Postgres connection string. For local dev without Docker, create a free
# instance at https://neon.tech (or any Postgres host) and paste its URL here.
DATABASE_URL=postgresql://user:password@host:5432/presora

# Any long random string — used to sign access tokens (openssl rand -hex 32).
JWT_ACCESS_SECRET=

# Claude Haiku 4.5 for prescription extraction. This is the whole reason this
# server exists instead of calling Anthropic from the device: Anthropic
# blocks direct API access from some regions (this project hit that from
# Hong Kong), but a server-to-server call from a supported region works fine.
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible) for storing prescription photos and profile
# pictures. Leave unset during early development — extraction still runs,
# photos just won't be persisted for later viewing until this is filled in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=presora
R2_PUBLIC_BASE_URL=

# Resend, for verification-code emails. Leave unset during development —
# codes are printed to the server console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Presora <onboarding@resend.dev>

PORT=3000
NODE_ENV=development
